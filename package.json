{
  "name": "starchild-orderly-plugin",
  "version": "1.4.1",
  "description": "Embed Starchild AI assistant into your Orderly DEX — chat with AI to query your Orderly account positions and orders.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "configSchema.json"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup && tailwindcss -i ./tailwind.css -o ./dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "orderly",
    "plugin",
    "ai",
    "assistant",
    "trading",
    "dex"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Starchild-ai-agent/starchild-orderly-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Starchild-ai-agent/starchild-orderly-plugin/issues"
  },
  "homepage": "https://github.com/Starchild-ai-agent/starchild-orderly-plugin#readme",
  "peerDependencies": {
    "@orderly.network/hooks": ">=3.0.0",
    "@orderly.network/plugin-core": ">=3.0.0",
    "@orderly.network/ui": ">=3.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@orderly.network/hooks": "^3.1.2",
    "@orderly.network/plugin-core": "^3.1.2",
    "@orderly.network/ui": "^3.1.2",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "bs58": "^6.0.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
